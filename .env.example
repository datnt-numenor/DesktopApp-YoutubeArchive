# Desktop-only defaults. The launcher always listens on 127.0.0.1.
APP_NAME=Desktop YouTube Archive
# Leave this placeholder to have the app generate a private key in data/secret.key.
SECRET_KEY=replace-with-any-long-random-local-secret

# All state stays on this computer. By default the app uses data/ytarchive.db
# and data/downloads, resolved from the project directory.
SYNC_INTERVAL_HOURS=12
YT_SLEEP_MIN_SECONDS=5
YT_SLEEP_MAX_SECONDS=15
DEFAULT_PLAYLIST_QUOTA=50
DEFAULT_STORAGE_QUOTA_GB=20
